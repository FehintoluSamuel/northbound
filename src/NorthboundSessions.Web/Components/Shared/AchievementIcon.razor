@* AchievementIcon.razor — inline SVG achievement art.

   Why inline SVG instead of <img src="/images/icons/*.png">:
     * inherits `currentColor`, so one icon works in light AND dark mode
     * crisp at any size, no @2x asset needed
     * no extra HTTP request, no layout shift
     * the previous approach used MarkupString with raw <img> tags and a
       hardcoded inline style, which could not be themed or sized from CSS.

   Usage:  <AchievementIcon Name="flame" />  *@

@namespace NorthboundSessions.Web.Components.Shared

<svg class="ach-icon @CssClass"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @Body
</svg>

@code {
    /// <summary>Icon key. See the switch in BuildFragment for the full set.</summary>
    [Parameter] public string Name { get; set; } = "sprout";

    /// <summary>Rendered width/height in px. Defaults suit the 44px badge.</summary>
    [Parameter] public int Size { get; set; } = 24;

    [Parameter] public string? CssClass { get; set; }

    private RenderFragment Body => BuildFragment(Name);

    private static RenderFragment Svg(string markup) => builder =>
    {
        builder.OpenElement(0, "g");
        builder.AddMarkupContent(1, markup);
        builder.CloseElement();
    };

