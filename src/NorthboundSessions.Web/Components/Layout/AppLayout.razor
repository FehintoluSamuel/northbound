@* src/NorthboundSessions.Web/Components/Layout/AppLayout.razor *@
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-shell">
    <header class="app-topbar">
        <a href="/dashboard" class="app-logo">
                  
            <svg viewBox="0 0 220 220" width="26" height="26">
                <circle cx="110" cy="110" r="98" fill="none" stroke="#1F2A44" stroke-width="8"/>
                <path d="M110 40 L134 148 L110 122 L86 148 Z" fill="#1F2A44"/>
                <circle cx="110" cy="24" r="10" fill="#16A34A"/>
            </svg>
       
        </a>
        <div class="app-avatar">@GetInitials()</div>
    </header>

        <main class="app-content">
        @Body
    </main>

    <nav class="app-bottombar">
        <a href="/dashboard" class="app-tab active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>Dashboard</span>
        </a>
        <a href="/lessons" class="app-tab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span>Lessons</span>
        </a>
        <a href="/quizzes" class="app-tab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Quizzes</span>
        </a>
        <a href="/sessions" class="app-tab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <span>Sessions</span>
        </a>
        <a href="/progress" class="app-tab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
            <span>Progress</span>
        </a>
    </nav>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string userDisplayName = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            userDisplayName = authState.User.Identity?.Name ?? "";
        }
    }

    private string GetInitials()
    {
        if (string.IsNullOrWhiteSpace(userDisplayName)) return "?";
        var namePart = userDisplayName.Contains('@') ? userDisplayName.Split('@')[0] : userDisplayName;
        var parts = namePart.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : namePart[..Math.Min(2, namePart.Length)].ToUpper();
    }
}