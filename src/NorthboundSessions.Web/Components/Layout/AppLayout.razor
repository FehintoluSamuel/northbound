@* AppLayout.razor — shared shell for student-facing pages
   (Dashboard, Lessons, Quizzes, Sessions, Progress).
   Requires InteractiveServer render mode on the HOSTING PAGE
   (e.g. @rendermode InteractiveServer in Dashboard.razor) —
   do NOT set it globally on <Routes /> in App.razor, since that
   breaks Identity's Login/Register pages. *@
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<div class="app-shell">

    <header class="topnav">
        <div class="topnav-inner">

            <a href="/dashboard" class="brand">
                <svg width="24" height="24" viewBox="0 0 26 26" fill="none" aria-hidden="true">
                    <circle cx="13" cy="13" r="11.5" stroke="#fff" stroke-width="1.6" />
                    <path d="M13 5.5L15.5 13L13 20.5L10.5 13L13 5.5Z" fill="#fff" />
                    <circle cx="13" cy="13" r="1.6" fill="#16A34A" />
                </svg>
            </a>

            <nav class="nav-links" aria-label="Primary">
                <NavLink href="/dashboard" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="/lessons">Lessons</NavLink>
                <NavLink href="/quizzes">Quizzes</NavLink>
                <NavLink href="/sessions">Sessions</NavLink>
                <NavLink href="/progress">Progress</NavLink>
            </nav>

            <div class="nav-right">
                <button class="icon-btn" @onclick="ToggleTheme" aria-label="Toggle dark mode">
                    @if (IsDark)
                    {
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="5" />
                            <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
                        </svg>
                    }
                    else
                    {
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                        </svg>
                    }
                </button>

                <button class="icon-btn" @onclick="DismissNotifications"
                        aria-label="Notifications" aria-pressed="@(!HasUnread)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 6.5-2.6 8.3-2.9 8.8a.6.6 0 0 0 .5 1h16.8a.6.6 0 0 0 .5-1C20.6 16.3 18 14.5 18 8Z" />
                        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                    </svg>
                    @if (HasUnread)
                    {
                        <span class="bell-dot"></span>
                    }
                </button>

                <div class="avatar-ring" title="@DisplayName">
                    <svg class="ring" width="38" height="38" viewBox="0 0 38 38" aria-hidden="true">
                        <circle cx="19" cy="19" r="16" class="ring-track" fill="none" stroke-width="3" />
                        <circle cx="19" cy="19" r="16" class="ring-progress" fill="none" stroke-width="3"
                                stroke-dasharray="100.5" stroke-dashoffset="@RingOffset" stroke-linecap="round" />
                    </svg>
                    <div class="avatar-fill">@Initials</div>
                </div>
            </div>

        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <NavMenu />

</div>

@code {
    private bool HasUnread { get; set; } = true;
    private bool IsDark { get; set; }
    private string DisplayName { get; set; } = string.Empty;
    private string Initials { get; set; } = "?";

    // Placeholder until this is wired to a real "overall completion" query.
    private int CompletionPercent { get; set; } = 70;
    private double RingOffset => 100.5 - (100.5 * CompletionPercent / 100.0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Identity.Name is the user's email — no display-name field exists yet.
        var email = user.Identity?.Name ?? string.Empty;
        DisplayName = email;

        var localPart = email.Contains('@') ? email[..email.IndexOf('@')] : email;
        Initials = localPart.Length >= 2
            ? localPart[..2].ToUpperInvariant()
            : localPart.ToUpperInvariant().PadRight(2, '?');
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("themeInterop.getTheme");
            IsDark = current == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("themeInterop.setTheme", IsDark ? "dark" : "light");
    }

    private void DismissNotifications()
    {
        HasUnread = false;
        // TODO: no notifications table exists yet — this is local-only state.
    }
}