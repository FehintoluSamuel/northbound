@page "/lessons/{LessonId:int}"
@rendermode InteractiveServer
@layout FocusLayout
@using Microsoft.AspNetCore.Authorization
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@using NorthboundSessions.Web.Services
@inject LessonProgressService ProgressService
@inject SlideService SlideService
@inject NavigationManager Nav
@using NorthboundSessions.Web.Data
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@attribute [Authorize]

@if (LessonNotFound)
{
    <div class="notfound-state"><p>This lesson doesn't exist.</p></div>
}
else if (CurrentLesson is not null)
{
    <div class="lesson-app">

        <div class="topbar">
            <button class="icon-btn" aria-label="Back to lessons" @onclick="BackToLessons">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <div class="lesson-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 19V5a2 2 0 0 1 2-2h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" /></svg>
            </div>
            <div class="topbar-title">@CurrentLesson.Title</div>

            <div class="progress-dots">
                @for (int i = 0; i < Slides.Count; i++)
                {
                    var idx = i;
                    var cls = idx == CurrentSlideIndex ? "current" : idx < CurrentSlideIndex || idx <= FurthestSlideReached ? "done" : "";
                    <div class="dot @cls"></div>
                }
            </div>

            <div class="topbar-right">
                @if (CurrentLesson.IsLiveDay && NextSessionId is not null)
                {
                    <button class="live-pill" @onclick="GoToCheckIn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                        Join live session
                    </button>
                }
                <button class="icon-btn" @onclick="ToggleTheme" aria-label="Toggle dark mode">
                    @if (IsDark)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="12" r="5" /><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
                    }
                </button>
            </div>
        </div>

        <div class="split-body @(CurrentLesson.MarketSymbol is null ? "no-chart" : "")">
            <div class="content-pane">
                <div class="eyebrow">Slide @(CurrentSlideIndex + 1) of @Slides.Count</div>
                @if (CurrentLesson.IsLiveDay)
                {
                    <div class="live-badge">Live session day</div>
                }
                <div class="slide-text">@Slides[CurrentSlideIndex]</div>
            </div>

            @if (CurrentLesson.MarketSymbol is not null)
            {
                <div class="chart-pane">
                    <div class="chart-pane-header">
                        <span>Market chart</span>
                        <span class="symbol">@CurrentLesson.MarketSymbol</span>
                    </div>
                    <div class="chart-body">
                        <div id="tv-chart"></div>
                    </div>
                </div>
            }
        </div>

        <div class="bottombar">
            <button class="btn-outline" disabled="@(CurrentSlideIndex == 0)" @onclick="GoPrevious">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 18l-6-6 6-6" /></svg>
                Back
            </button>

            @if (CurrentSlideIndex < Slides.Count - 1)
            {
                <button class="btn-primary" @onclick="GoNext">
                    Next
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M9 6l6 6-6 6" /></svg>
                </button>
            }
            else if (QuizId is not null)
            {
                <button class="btn-primary @(!QuizUnlocked ? "locked" : "")" disabled="@(!QuizUnlocked)" @onclick="GoToQuiz">
                    @(QuizUnlocked ? "Take the quiz" : "Finish reading to unlock quiz")
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int LessonId { get; set; }

    private Lesson? CurrentLesson;
    private bool LessonNotFound;
    private List<string> Slides = new();
    private int CurrentSlideIndex;
    private int FurthestSlideReached;
    private int? QuizId;
    private int? NextSessionId;
    private string _studentId = string.Empty;
    private bool _chartRendered;
    private bool IsDark;

    private bool QuizUnlocked => FurthestSlideReached >= Slides.Count - 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _studentId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();

        CurrentLesson = await db.Lessons.FindAsync(LessonId);
        if (CurrentLesson is null)
        {
            LessonNotFound = true;
            return;
        }

        Slides = SlideService.GenerateSlides(CurrentLesson).Select(s => s.BodyText).ToList();
        if (Slides.Count == 0) Slides.Add(CurrentLesson.OutlineContent ?? string.Empty);

        QuizId = await db.Quizzes
            .Where(q => q.LessonId == CurrentLesson.Id)
            .Select(q => (int?)q.Id)
            .FirstOrDefaultAsync();

        if (CurrentLesson.IsLiveDay)
        {
            NextSessionId = await db.LiveSessions
                .Where(s => s.ScheduledAt >= DateTime.UtcNow)
                .OrderBy(s => s.ScheduledAt)
                .Select(s => (int?)s.Id)
                .FirstOrDefaultAsync();
        }

        if (!string.IsNullOrEmpty(_studentId))
        {
            FurthestSlideReached = await ProgressService.GetFurthestSlideAsync(_studentId, LessonId);
            CurrentSlideIndex = Math.Min(FurthestSlideReached, Slides.Count - 1);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("themeInterop.getTheme");
            IsDark = current == "dark";
            StateHasChanged();
        }

        if (CurrentLesson?.MarketSymbol is not null && !_chartRendered)
        {
            _chartRendered = true;
            await JS.InvokeVoidAsync("renderTradingViewWidget", "tv-chart", CurrentLesson.MarketSymbol);
        }
    }

    private async Task ToggleTheme()
    {
        IsDark = !IsDark;
        await JS.InvokeVoidAsync("themeInterop.setTheme", IsDark ? "dark" : "light");
    }

    private async Task GoNext()
    {
        if (CurrentSlideIndex < Slides.Count - 1)
        {
            CurrentSlideIndex++;
            if (CurrentSlideIndex > FurthestSlideReached)
            {
                FurthestSlideReached = CurrentSlideIndex;
                if (!string.IsNullOrEmpty(_studentId))
                {
                    await ProgressService.RecordProgressAsync(_studentId, LessonId, FurthestSlideReached);
                }
            }
        }
    }

    private void GoPrevious()
    {
        if (CurrentSlideIndex > 0) CurrentSlideIndex--;
    }

    private void GoToQuiz()
    {
        if (QuizId is not null) Nav.NavigateTo($"/quizzes/{QuizId}/take");
    }

    private void GoToCheckIn()
    {
        if (NextSessionId is not null) Nav.NavigateTo($"/sessions/{NextSessionId}/checkin");
    }

    private void BackToLessons() => Nav.NavigateTo("/view-all-lessons");
}
