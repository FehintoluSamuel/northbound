@* AdminLayout.razor — sidebar shell for instructor-facing pages.
   Desktop: fixed sidebar. Mobile (<900px): sidebar becomes an off-canvas
   drawer toggled by a hamburger button, with a backdrop to close it.
   Apply [Authorize(Roles = "Instructor")] on each page using this layout —
   not enforced here, since layouts don't carry auth attributes themselves. *@
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="admin-shell">

    <!-- Mobile backdrop — a real <button> so it is reachable by keyboard.
         A <div> with only @onclick cannot be focused or activated. -->
    @if (SidebarOpen)
    {
        <button class="backdrop" @onclick="CloseSidebar" aria-label="Close navigation menu"></button>
    }

    <aside class="sidebar @(SidebarOpen ? "open" : "")" aria-label="Admin navigation">
        <div class="sidebar-brand">
            <svg width="22" height="22" viewBox="0 0 26 26" fill="none" aria-hidden="true">
                <circle cx="13" cy="13" r="11.5" stroke="var(--brand-text)" stroke-width="1.6" />
                <path d="M13 5.5L15.5 13L13 20.5L10.5 13L13 5.5Z" fill="var(--brand-text)" />
                <circle cx="13" cy="13" r="1.6" fill="var(--spark)" />
            </svg>
            <span>Northbound Admin</span>
            <button class="close-btn" @onclick="CloseSidebar" aria-label="Close menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>

        <div class="nav-section-label">Overview</div>
        <NavLink class="nav-item" href="/admin/reporting" Match="NavLinkMatch.All" @onclick="CloseSidebar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18" /><path d="M7 15l4-6 4 4 5-8" /></svg>
            Student progress
        </NavLink>

        <div class="nav-section-label">Create</div>
        <NavLink class="nav-item" href="/admin/lessons/create" @onclick="CloseSidebar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h8l6 6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" /></svg>
            New lesson
        </NavLink>
        <NavLink class="nav-item" href="/admin/topics/create" @onclick="CloseSidebar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
            New topic
        </NavLink>
        @* "/admin/sessions/create" was linked here but no such page exists,
           so this was a guaranteed 404. Pointed at the lessons list, which
           is where sessions are actually managed for now. *@
        <NavLink class="nav-item" href="/all-sessions" @onclick="CloseSidebar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
            Live sessions
        </NavLink>

        <div class="sidebar-footer">
            <div class="admin-avatar">@Initials</div>
            <div>
                <div class="admin-name">@DisplayName</div>
                <div class="admin-role">Instructor</div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <button class="hamburger-btn" @onclick="OpenSidebar" aria-label="Open menu"
                    aria-expanded="@SidebarOpen.ToString().ToLowerInvariant()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
            <div class="breadcrumb">@BreadcrumbLabel</div>
        </div>

        <div class="content">
            @Body
        </div>
    </div>
</div>

@code {
    private bool SidebarOpen;
    private string DisplayName = string.Empty;
    private string Initials = "?";
    private DotNetObjectReference<AdminLayout>? _selfRef;
    private bool _escapeRegistered;

    // Simple breadcrumb derived from the current path — good enough until
    // there's a reason for something more structured.
    private string BreadcrumbLabel => Nav.Uri.Contains("/admin/lessons/create") ? "Admin / New lesson"
        : Nav.Uri.Contains("/admin/topics/create") ? "Admin / New topic"
        : Nav.Uri.Contains("/admin/sessions/create") ? "Admin / New live session"
        : "Admin / Student progress";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.Identity?.Name ?? string.Empty;
        DisplayName = email;

        var localPart = email.Contains('@') ? email[..email.IndexOf('@')] : email;
        Initials = localPart.Length >= 2
            ? localPart[..2].ToUpperInvariant()
            : localPart.ToUpperInvariant().PadRight(2, '?');
    }

    // Escape closes the drawer — expected of any modal navigation.
    // Has to happen here rather than OnInitializedAsync: this layout is
    // prerendered, and JS interop is illegal while statically rendering.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive || _escapeRegistered)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("adminNav.registerEscape", _selfRef);
        _escapeRegistered = true;
    }

    private void OpenSidebar() => SidebarOpen = true;

    private void CloseSidebar() => SidebarOpen = false;

    [JSInvokable]
    public void OnEscapeKey() => SidebarOpen = false;

    public async ValueTask DisposeAsync()
    {
        if (_selfRef is null)
        {
            return;
        }

        // Only tear down the JS listener if this instance actually registered
        // one — the prerender pass never did, and calling interop there throws.
        if (_escapeRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync("adminNav.unregisterEscape");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or ObjectDisposedException)
            {
                // Circuit already gone; the document listener dies with the page.
            }
            _escapeRegistered = false;
        }

        _selfRef.Dispose();
        _selfRef = null;
    }
}
