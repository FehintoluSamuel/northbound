@page "/admin/topics/create"
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@layout AdminLayout
@using NorthboundSessions.Web
@attribute [Authorize(Roles = "Instructor")]
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@using NorthboundSessions.Web.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<div class="page-title-row"><h1>Add a topic to the bank</h1></div>
<div class="page-sub">Reusable lesson material for LessonGeneratorService to draw from on scheduled days.</div>

<EditForm Model="this" FormName="CreateTopic" OnValidSubmit="SaveTopic">

    <div class="form-card">
        <h2>Topic details</h2>

        <label class="field-label">Title</label>
        <InputText @bind-Value="newTopic.Title" class="text-input" />

        <label class="field-label">Outline content</label>
        <InputTextArea @bind-Value="newTopic.OutlineContent" rows="6" class="text-area" />

        <label class="field-label">Market symbol <span class="optional">(optional, e.g. NYSE:NKE)</span></label>
        <InputText @bind-Value="newTopic.MarketSymbol" class="text-input" />

        <label class="field-label">Lesson image <span class="optional">(optional, 16:9 works best, e.g. 800×450)</span></label>
        <div class="image-upload-row">
            <InputFile OnChange="HandleImageSelected" accept="image/png,image/jpeg" class="file-input" />
            @if (imagePreviewUrl is not null)
            {
                <img src="@imagePreviewUrl" class="image-preview" alt="" />
            }
        </div>
    </div>

    <div class="form-card">
        <div class="section-head-row">
            <h2>Quiz questions</h2>
        </div>

        @foreach (var question in newTopic.Questions)
        {
            <div class="question-block">
                <label class="field-label">Question text</label>
                <InputText @bind-Value="question.QuestionText" class="text-input" />

                <div class="options-label">Options</div>
                @foreach (var option in question.Options)
                {
                    <div class="option-row">
                        <InputText @bind-Value="option.OptionText" placeholder="Option text" class="text-input option-text" />
                        <label class="correct-checkbox-label">
                            <InputCheckbox @bind-Value="option.IsCorrect" />
                            Correct
                        </label>
                    </div>
                }
                <button type="button" class="add-option-btn" @onclick="() => AddOption(question)">+ Add option</button>
            </div>
        }
        <button type="button" class="add-question-btn" @onclick="AddQuestion">+ Add question</button>
    </div>

    <div class="submit-row">
        <button type="submit" class="btn-primary">Save topic</button>
    </div>

</EditForm>

@code {
    private TopicBankItem newTopic = new() { Title = "", OutlineContent = "" };

    private void AddQuestion()
    {
        newTopic.Questions.Add(new BankQuestion
        {
            QuestionText = "",
            DisplayOrder = newTopic.Questions.Count + 1
        });
    }

    private void AddOption(BankQuestion question)
    {
        question.Options.Add(new BankOption
        {
            OptionText = "",
            DisplayOrder = question.Options.Count + 1
        });
    }

    private async Task SaveTopic()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.TopicBankItems.Add(newTopic);
        await context.SaveChangesAsync();
        Nav.NavigateTo("/admin/topics/create");
    }

    private string? imagePreviewUrl;

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5MB cap
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);

        newTopic.ImageBytes = memoryStream.ToArray();
        imagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(newTopic.ImageBytes)}";
    }
}
