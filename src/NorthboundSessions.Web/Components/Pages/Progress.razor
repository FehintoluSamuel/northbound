@page "/progress"
@rendermode InteractiveServer
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@using NorthboundSessions.Web.Services
@inject NavigationManager Nav
@using NorthboundSessions.Web.Data
@inject AchievementService Achievements
@attribute [Authorize]

<PageTitle>Your progress · Northbound</PageTitle>

<div class="container">
    <div class="page-header">
        <h1>Your progress</h1>
    </div>

    <!-- Overview -->
    <section class="section">
        <div class="metric-row">
            <div class="metric"><div class="metric-num text-stat">@LessonsCompletedCount</div><div class="text-small">Lessons completed</div></div>
            <div class="metric"><div class="metric-num text-stat">@(AverageQuizScore is null ? "—" : $"{AverageQuizScore:0}%")</div><div class="text-small">Average quiz score</div></div>
            <div class="metric"><div class="metric-num text-stat">@SessionsAttendedCount</div><div class="text-small">Sessions attended</div></div>
            <div class="metric"><div class="metric-num text-stat">@CurrentStreak</div><div class="text-small">Current streak</div></div>
        </div>
    </section>

    <!-- Achievements -->
    <section class="section">
        <div class="section-head">
            <h2>Achievements</h2>
            <span class="text-small">@EarnedCount of @AchievementStates.Count earned</span>
        </div>
        @if (AchievementStates.Count == 0)
        {
            <div class="empty-state text-small">No achievements yet — start a lesson to unlock your first one.</div>
        }
        else
        {
            <AchievementGrid Items="@AchievementStates" />
        }
    </section>

    <!-- Quiz history -->
    <section class="section">
        <div class="section-head"><h2>Quiz history</h2></div>
        @if (QuizHistory.Count == 0)
        {
            <div class="empty-state text-small">No quizzes attempted yet.</div>
        }
        else
        {
            <div class="history-list">
                @foreach (var attempt in QuizHistory)
                {
                    <div class="history-item">
                        <div class="score-chip @(attempt.Score >= 70 ? "pass" : "fail")">@attempt.Score%</div>
                        <div class="history-body">
                            <div class="history-title text-body">@attempt.QuizTitle</div>
                            <div class="text-small">@attempt.SubmittedAt.ToString("MMM d, yyyy")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Attendance history -->
    <section class="section">
        <div class="section-head"><h2>Session attendance</h2></div>
        @if (AttendanceHistory.Count == 0)
        {
            <div class="empty-state text-small">No sessions attended yet.</div>
        }
        else
        {
            <div class="history-list">
                @foreach (var record in AttendanceHistory)
                {
                    <div class="history-item">
                        <div class="check-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg>
                        </div>
                        <div class="history-body">
                            <div class="history-title text-body">@record.Topic</div>
                            <div class="text-small">Checked in @record.CheckedInAt.ToString("MMM d, yyyy")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private int LessonsCompletedCount;
    private double? AverageQuizScore;
    private int SessionsAttendedCount;
    private int CurrentStreak;
    private string _studentId = string.Empty;

    private IReadOnlyList<AchievementState> AchievementStates = Array.Empty<AchievementState>();
    private int EarnedCount => AchievementStates.Count(a => a.Unlocked);

    private List<QuizHistoryItem> QuizHistory = new();
    private List<AttendanceHistoryItem> AttendanceHistory = new();

    private record QuizHistoryItem(string QuizTitle, int Score, DateTime SubmittedAt);
    private record AttendanceHistoryItem(string Topic, DateTime CheckedInAt);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _studentId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        if (string.IsNullOrEmpty(_studentId)) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var attempts = await db.QuizAttempts
            .Where(a => a.StudentId == _studentId)
            .Include(a => a.Quiz)
            .OrderByDescending(a => a.SubmittedAt)
            .ToListAsync();

        var attendances = await db.Attendances
            .Where(a => a.StudentId == _studentId)
            .Include(a => a.LiveSession)
            .OrderByDescending(a => a.CheckedInAt)
            .ToListAsync();

        var quizIds = attempts.Select(a => a.QuizId).Distinct().ToList();
        var questionCounts = await db.QuizQuestions
            .Where(q => quizIds.Contains(q.QuizId))
            .GroupBy(q => q.QuizId)
            .Select(g => new { QuizId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.QuizId, x => x.Count);

        double ToPercent(QuizAttempt a) =>
            questionCounts.TryGetValue(a.QuizId, out var total) && total > 0
                ? a.Score * 100.0 / total : 0;

        // "Lessons completed" means distinct lessons touched, so count via
        // each quiz's lesson. Averaging raw Score (a point count) instead of
        // ToPercent() made this show e.g. "7%" instead of "78%".
        var lessonIdsByQuiz = await db.Quizzes
            .Where(q => quizIds.Contains(q.Id))
            .Select(q => new { q.Id, q.LessonId })
            .ToDictionaryAsync(x => x.Id, x => x.LessonId);

        LessonsCompletedCount = attempts
            .Select(a => lessonIdsByQuiz.TryGetValue(a.QuizId, out var lessonId) ? lessonId : (int?)null)
            .Where(id => id is not null)
            .Distinct()
            .Count();

        var percents = attempts.Select(ToPercent).ToList();
        AverageQuizScore = percents.Count > 0 ? percents.Average() : null;
        SessionsAttendedCount = attendances.Count;

        var activityDates = attempts.Select(a => a.SubmittedAt.Date)
            .Concat(attendances.Select(a => a.CheckedInAt.Date))
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();

        CurrentStreak = AchievementService.ComputeStreaks(activityDates).current;

        QuizHistory = attempts
            .Select(a => new QuizHistoryItem(a.Quiz?.Title ?? "Quiz", (int)Math.Round(ToPercent(a)), a.SubmittedAt.DateTime))
            .ToList();

        AttendanceHistory = attendances
            .Select(a => new AttendanceHistoryItem(a.LiveSession?.Topic ?? "Live session", a.CheckedInAt.DateTime))
            .ToList();

        AchievementStates = await Achievements.GetAchievementsAsync(_studentId);
    }
}

