@page "/all-sessions"
@rendermode InteractiveServer
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@using NorthboundSessions.Web.Services
@using NorthboundSessions.Web.Data
@attribute [Authorize]



<div class="container">
    <div class="page-header"><h1>Sessions</h1></div>

    <section class="section">
        <div class="section-head"><h2>Upcoming</h2></div>
        @if (Upcoming.Count == 0)
        {
            <div class="empty-state text-small">No upcoming sessions scheduled.</div>
        }
        else
        {
            <div class="list">
                @foreach (var item in Upcoming)
                {
                    <a class="list-item" href="@($"/sessions/{item.Id}/checkin")">
                        <span class="status-icon @(item.CheckedIn ? "done" : "pending")" aria-hidden="true">
                            @if (item.CheckedIn)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                            }
                        </span>
                        <span class="list-body">
                            <span class="list-title text-body">@item.Topic</span>
                            <span class="text-small">@item.ScheduledAt.ToString("ddd, MMM d · h:mm tt")@(item.CheckedIn ? " · checked in" : "")</span>
                        </span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="section">
        <div class="section-head"><h2>Past</h2></div>
        @if (Past.Count == 0)
        {
            <div class="empty-state text-small">No past sessions yet.</div>
        }
        else
        {
            <div class="list">
                @foreach (var item in Past)
                {
                    <a class="list-item" href="@($"/sessions/{item.Id}/checkin")">
                        <span class="status-icon @(item.CheckedIn ? "done" : "missed")" aria-hidden="true">
                            @if (item.CheckedIn)
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5" /></svg>
                            }
                            else
                            {
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" /></svg>
                            }
                        </span>
                        <span class="list-body">
                            <span class="list-title text-body">@item.Topic</span>
                            <span class="text-small">@item.ScheduledAt.ToString("MMM d, yyyy")@(item.CheckedIn ? " · attended" : " · missed")</span>
                        </span>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    private record SessionRow(int Id, string Topic, DateTimeOffset ScheduledAt, bool CheckedIn);

    private List<SessionRow> Upcoming = new();
    private List<SessionRow> Past = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var studentId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();

        var sessions = await db.LiveSessions.OrderBy(s => s.ScheduledAt).ToListAsync();

        var checkedInIds = string.IsNullOrEmpty(studentId)
            ? new HashSet<int>()
            : (await db.Attendances
                .Where(a => a.StudentId == studentId)
                .Select(a => a.LiveSessionId)
                .ToListAsync()).ToHashSet();

        var now = DateTimeOffset.UtcNow;

        foreach (var s in sessions)
        {
            var row = new SessionRow(s.Id, s.Topic, s.ScheduledAt, checkedInIds.Contains(s.Id));
            if (s.ScheduledAt >= now) Upcoming.Add(row);
            else Past.Add(row);
        }

        Past.Reverse(); // most recent past session first
    }
}