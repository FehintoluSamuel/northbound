@page "/dashboard"
@rendermode InteractiveServer
@layout AppLayout
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject AchievementService Achievements
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@using Microsoft.AspNetCore.Authorization
@using NorthboundSessions.Web.Data
@using NorthboundSessions.Web.Services
@attribute [Authorize]

<PageTitle>Dashboard | Northbound Sessions</PageTitle>

<div class="hero">
    <img class="hero-img" src="/images/hero-banner1.jpg" alt="" width="2000" height="1333"
         fetchpriority="high" decoding="async" />
    <div class="hero-overlay">
        <div class="hero-eyebrow">@Greeting</div>
        <h1>Good @TimeOfDay, @DisplayFirstName.</h1>
        @if (NextLesson is not null)
        {
            <p>@NextLesson.Title is up next@(NextLesson.MarketSymbol is not null ? $" — covers {NextLesson.MarketSymbol}" : "").</p>
            <a class="hero-cta" href="@($"/lessons/{NextLesson.Id}")">
                Continue today's lesson
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
        }
        else
        {
            <p>No lesson has been released yet — check back soon.</p>
        }
    </div>
</div>

<div class="container">

    <!-- Streak -->
    <div class="streak-row">
        <div class="streak-left">
            <span class="streak-icon" aria-hidden="true">
                <AchievementIcon Name="flame" Size="22" />
            </span>
            <div>
                <div class="streak-num text-stat">
                    @(CurrentStreak == 1 ? "1 day streak" : $"{CurrentStreak} day streak")
                </div>
                <div class="text-small">Based on quiz attempts and session check-ins</div>
            </div>
        </div>
        <div class="text-small">Longest streak: @LongestStreak days</div>
    </div>

    <!-- Continue learning -->
    @if (NextLesson is not null)
    {
        <section class="section" aria-labelledby="h-continue">
            <div class="section-head"><h2 id="h-continue">Continue learning</h2></div>
            <div class="lesson-card">
                @* Lesson images are stored as byte[] on the Lesson row, not as
                   files under wwwroot. The old src was "/images/lessons/{id}.jpg",
                   which matched no static file: it fell through to the Blazor
                   router, 302'd to the login page and returned HTML, so the <img>
                   failed to decode and onerror replaced it with the default —
                   the uploaded image never showed. The endpoint below returns the
                   bytes, and itself redirects to the default when a lesson has
                   no image, so onerror is now only a last-resort safety net. *@
                <img class="lesson-thumb" src="@($"/api/lessons/{NextLesson.Id}/image")"
                     width="700" height="466" loading="lazy" decoding="async"
                     onerror="this.onerror=null;this.src='/images/lessons/continue_learning_default.jpg';" alt="" />
                <div class="lesson-body">
                    <h3 class="text-h3">@NextLesson.Title</h3>
                    <div class="progress-meta text-small">
                        Released @NextLesson.ReleaseDate.ToString("MMM d")
                        @(NextLesson.IsLiveDay ? " · live session day" : "")
                    </div>
                    <a class="resume-btn" href="@($"/lessons/{NextLesson.Id}")">View lesson</a>
                </div>
            </div>
        </section>
    }

    <!-- Next live session -->
    <section class="section" aria-labelledby="h-session">
        <div class="section-head"><h2 id="h-session">Next live session</h2></div>
        @if (NextSession is not null)
        {
            <div class="session-card">
                @* Path was "images/instructors/default.jpg" but that directory is
                   empty — a guaranteed 404 on every dashboard render. The real
                   asset is images/instructor.jpg. *@
                <img class="session-photo" src="/images/instructor.jpg"
                     width="283" height="400" loading="lazy" decoding="async" alt="" />
                <div class="session-body">
                    <h3 class="text-h3">@NextSession.Topic</h3>
                    <p class="text-small">@NextSession.ScheduledAt.ToString("ddd, MMM d · h:mm tt")</p>
                </div>
                <a class="join-btn" href="@($"/sessions/{NextSession.Id}/checkin")">Check in</a>
            </div>
        }
        else
        {
            <div class="empty-state text-small">
                No upcoming live session scheduled yet.
            </div>
        }
    </section>

    <!-- Achievements -->
    <section class="section" aria-labelledby="h-ach">
        <div class="section-head">
            <h2 id="h-ach">Achievements</h2>
            <a class="section-link" href="/progress">View all @AchievementStates.Count</a>
        </div>

        @if (AchievementStates.Count > 0)
        {
            <div class="ach-summary">
                <div class="ach-summary-num text-stat">@UnlockedCount</div>
                <div class="text-small">of @AchievementStates.Count earned</div>
                <div class="ach-summary-bar" role="img"
                     aria-label="@UnlockedCount of @AchievementStates.Count achievements earned">
                    <span style="width:@($"{UnlockedPercent:0}%")"></span>
                </div>
            </div>

            @* Show the handful closest to completion, not all 30 at once. *@
            <div class="ach-strip">
                @foreach (var state in UpNextAchievements)
                {
                    <div class="ach-strip-item">
                        <div class="ach-strip-icon tier-@TierSlug(state.Definition.Tier)">
                            <AchievementIcon Name="@state.Definition.Icon" Size="20" />
                        </div>
                        <div class="ach-strip-body">
                            <div class="ach-strip-name">@state.Definition.Name</div>
                            <div class="ach-strip-meta text-micro">
                                @state.Current / @state.Definition.Goal
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- This week -->
    <section class="section" aria-labelledby="h-week">
        <div class="section-head"><h2 id="h-week">This week</h2></div>
        <div class="metric-row">
            <div class="metric">
                <div class="metric-num text-stat">@LessonsCompletedCount</div>
                <div class="text-small">Lessons completed</div>
            </div>
            <div class="metric">
                <div class="metric-num text-stat">@(AverageQuizScore is null ? "—" : $"{AverageQuizScore:0}%")</div>
                <div class="text-small">Average quiz score</div>
            </div>
            <div class="metric">
                <div class="metric-num text-stat">@SessionsAttendedCount</div>
                <div class="text-small">Sessions attended</div>
            </div>
        </div>
    </section>

    <!-- Recent activity -->
    <section class="section" aria-labelledby="h-activity">
        <div class="section-head"><h2 id="h-activity">Recent activity</h2></div>
        @if (RecentActivity.Count == 0)
        {
            <p class="text-small">No activity yet — quiz attempts and session check-ins will show up here.</p>
        }
        else
        {
            <ul class="activity">
                @foreach (var item in RecentActivity)
                {
                    <li class="activity-item">
                        <span class="activity-icon" aria-hidden="true">
                            <AchievementIcon Name="checklist" Size="14" />
                        </span>
                        <span class="activity-text text-body">@item.Description</span>
                        <span class="activity-time text-small">@item.When.ToString("MMM d")</span>
                    </li>
                }
            </ul>
        }
    </section>

</div>

@code {
    private Lesson? NextLesson;
    private LiveSession? NextSession;
    private int LessonsCompletedCount;
    private double? AverageQuizScore;
    private int SessionsAttendedCount;
    private int CurrentStreak;
    private int LongestStreak;
    private string DisplayFirstName = "there";
    private string _studentId = string.Empty;

    private List<ActivityItem> RecentActivity = new();
    private IReadOnlyList<AchievementState> AchievementStates = Array.Empty<AchievementState>();

    private record ActivityItem(string Description, DateTime When);

    private int UnlockedCount => AchievementStates.Count(a => a.Unlocked);
    private int UnlockedPercent => AchievementStates.Count == 0 ? 0 : UnlockedCount * 100 / AchievementStates.Count;

    /// <summary>The 4 locked achievements closest to completion — a motivating next step.</summary>
    private IEnumerable<AchievementState> UpNextAchievements => AchievementStates
        .Where(a => !a.Unlocked && a.Definition.Goal > 0)
        .OrderByDescending(a => a.Percent)
        .ThenBy(a => a.Definition.Goal)
        .Take(4);

    private static string TimeOfDay
    {
        get
        {
            var h = DateTime.Now.Hour;
            return h < 12 ? "morning" : h < 18 ? "afternoon" : "evening";
        }
    }

    private string Greeting => NextLesson is null
        ? "Welcome back"
        : NextLesson.IsLiveDay
            ? "Live day"
            : "Today's focus";

    private static string TierSlug(AchievementTier tier) => tier switch
    {
        AchievementTier.Bronze => "bronze",
        AchievementTier.Silver => "silver",
        AchievementTier.Gold   => "gold",
        _                     => "none",
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _studentId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        var email = user.Identity?.Name ?? string.Empty;
        if (email.Contains('@'))
        {
            DisplayFirstName = email[..email.IndexOf('@')];
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        NextLesson = await db.Lessons
            .Where(l => l.ReleaseDate <= DateOnly.FromDateTime(DateTime.UtcNow))
            .OrderByDescending(l => l.ReleaseDate)
            .FirstOrDefaultAsync();

        NextSession = await db.LiveSessions
            .Where(s => s.ScheduledAt >= DateTime.UtcNow)
            .OrderBy(s => s.ScheduledAt)
            .FirstOrDefaultAsync();

        AchievementStates = await Achievements.GetAchievementsAsync(_studentId);

        if (string.IsNullOrEmpty(_studentId))
        {
            return;
        }

        var attempts = await db.QuizAttempts
            .Where(a => a.StudentId == _studentId)
            .ToListAsync();

        var attendances = await db.Attendances
            .Where(a => a.StudentId == _studentId)
            .ToListAsync();

        var quizIds = attempts.Select(a => a.QuizId).Distinct().ToList();
        var questionCounts = await db.QuizQuestions
            .Where(q => quizIds.Contains(q.QuizId))
            .GroupBy(q => q.QuizId)
            .Select(g => new { QuizId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.QuizId, x => x.Count);

        double ToPercent(QuizAttempt a) =>
            questionCounts.TryGetValue(a.QuizId, out var total) && total > 0
                ? a.Score * 100.0 / total : 0;

        LessonsCompletedCount = attempts.Select(a => a.QuizId).Distinct().Count();
        AverageQuizScore = attempts.Count > 0 ? attempts.Average(ToPercent) : null;
        SessionsAttendedCount = attendances.Count;

        var activityDates = attempts.Select(a => a.SubmittedAt.UtcDateTime.Date)
            .Concat(attendances.Select(a => a.CheckedInAt.UtcDateTime.Date))
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();

        (CurrentStreak, LongestStreak) = AchievementService.ComputeStreaks(activityDates);

        var quizActivity = attempts
            .OrderByDescending(a => a.SubmittedAt)
            .Take(3)
            .Select(a => new ActivityItem($"Scored {(int)Math.Round(ToPercent(a))}% on a quiz", a.SubmittedAt.UtcDateTime));

        var attendanceActivity = attendances
            .OrderByDescending(a => a.CheckedInAt)
            .Take(3)
            .Select(a => new ActivityItem("Checked in to a live session", a.CheckedInAt.UtcDateTime));

        RecentActivity = quizActivity.Concat(attendanceActivity)
            .OrderByDescending(a => a.When)
            .Take(5)
            .ToList();
    }
}
