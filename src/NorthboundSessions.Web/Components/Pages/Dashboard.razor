@page "/dashboard"
@rendermode InteractiveServer
@layout AppLayout
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@using Microsoft.AspNetCore.Authorization
@using NorthboundSessions.Web.Data
@using NorthboundSessions.Data
@attribute [Authorize]

<div class="hero">
    <img class="hero-img" src="/images/hero-banner1.jpg" alt="" />
    <div class="hero-overlay">
        <div class="hero-eyebrow">Today's focus</div>
        <h1>Good morning, @DisplayFirstName.</h1>
        @if (NextLesson is not null)
        {
            <p>@NextLesson.Title is up next@(NextLesson.MarketSymbol is not null ? $" — covers {NextLesson.MarketSymbol}" : "").</p>
            <a class="hero-cta" href="@($"/lessons/{NextLesson.Id}")">
                Continue today's lesson
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2.6"><path d="M9 6l6 6-6 6" /></svg>
            </a>
        }
        else
        {
            <p>No lesson has been released yet — check back soon.</p>
        }
    </div>
</div>

<div class="container">

    <!-- Streak -->
    <div class="streak-row">
        <div class="streak-left">
            <img src="/images/icons/fire.png" width="22" height="22" alt="Streak" />
            <div>
                <div class="streak-num text-stat">@CurrentStreak day streak</div>
                <div class="text-small">Based on quiz attempts and session check-ins</div>
            </div>
        </div>
        <div class="text-small">Longest streak: @LongestStreak days</div>
    </div>

    <!-- Continue learning -->
    @if (NextLesson is not null)
    {
        <section class="section">
            <div class="section-head"><h2>Continue learning</h2></div>
            <div class="lesson-card">
                <img class="lesson-thumb" src="@($"/images/lessons/{NextLesson.Id}.jpg")"
                     onerror="this.onerror=null;this.src='/images/lessons/continue_learning_default.jpg';" alt="" />
                <div class="lesson-body">
                    <h3 class="text-h3">@NextLesson.Title</h3>
                    <div class="progress-meta text-small">
                        Released @NextLesson.ReleaseDate.ToString("MMM d")
                        @(NextLesson.IsLiveDay ? " · live session day" : "")
                    </div>
                    <a class="resume-btn" href="@($"/lessons/{NextLesson.Id}")">View lesson</a>
                </div>
            </div>
        </section>
    }

    <!-- Next live session -->
    <section class="section">
        <div class="section-head"><h2>Next live session</h2></div>
        @if (NextSession is not null)
        {
            <div class="session-card">
                <img class="session-photo" src="images/instructors/default.jpg" alt="" />
                <div class="session-body">
                    <h3 class="text-h3">@NextSession.Topic</h3>
                    <p class="text-small">@NextSession.ScheduledAt.ToString("ddd, MMM d · h:mm tt")</p>
                </div>
                <a class="join-btn" href="@($"/sessions/{NextSession.Id}/checkin")">Check in</a>
            </div>
        }
        else
        {
            <div class="empty-state text-small">
                No upcoming live session scheduled yet.
            </div>
        }
    </section>
    
    <!-- Achievements -->
    <section class="section">
        <div class="section-head"><h2>Achievements</h2></div>
        <div class="badge-scroll">
            @foreach (var badge in Achievements)
            {
                <div class="badge @(badge.Unlocked ? "unlocked" : "")" title="@badge.Description">
                    <div class="badge-circle">
                        @((MarkupString)badge.IconSvg)
                    </div>
                    <div class="badge-name text-micro">@badge.Name</div>
                </div>
            }
        </div>
    </section>

    <!-- This week -->
    <section class="section">
        <div class="section-head"><h2>This week</h2></div>
        <div class="metric-row">
            <div class="metric"><div class="metric-num text-stat">@LessonsCompletedCount</div><div class="text-small">Lessons completed</div></div>
            <div class="metric"><div class="metric-num text-stat">@(AverageQuizScore is null ? "—" : $"{AverageQuizScore:0}%")</div><div class="text-small">Average quiz score</div></div>
            <div class="metric"><div class="metric-num text-stat">@SessionsAttendedCount</div><div class="text-small">Sessions attended</div></div>
        </div>
    </section>

    <!-- Recent activity -->
    <section class="section">
        <div class="section-head"><h2>Recent activity</h2></div>
        @if (RecentActivity.Count == 0)
        {
            <p class="text-small">No activity yet — quiz attempts and session check-ins will show up here.</p>
        }
        else
        {
            <div class="activity">
                @foreach (var item in RecentActivity)
                {
                    <div class="activity-item">
                        <img src="/images/icons/checklist.png" width="14" height="14" alt="" />
                        <div class="activity-text text-body">@item.Description</div>
                        <div class="activity-time text-small">@item.When.ToString("MMM d")</div>
                    </div>
                }
            </div>
        }
    </section>

</div>

@code {
    private Lesson? NextLesson;
    private LiveSession? NextSession;
    private int LessonsCompletedCount;
    private double? AverageQuizScore;
    private int SessionsAttendedCount;
    private int CurrentStreak;
    private int LongestStreak;
    private string DisplayFirstName = "there";
    private string _studentId = string.Empty;

    private List<ActivityItem> RecentActivity = new();
    private List<Achievement> Achievements = new();

    private record ActivityItem(string Description, DateTime When);
    private record Achievement(string Name, string Description, string IconSvg, bool Unlocked);

    private const string IconMedal = "<img src=\"/images/icons/rocket-launch.png\" style=\"width:100%; height:100%; object-fit:contain;\" alt=\"First Quiz\" />";
    private const string IconFlame = "<img src=\"/images/icons/fire.png\" style=\"width:100%; height:100%; object-fit:contain;\" alt=\"Streak\" />";
    private const string IconSunrise = "<img src=\"/images/icons/sunrise.png\" style=\"width:100%; height:100%; object-fit:contain;\" alt=\"Early Bird\" />";
    private const string IconTarget = "<img src=\"/images/icons/target.png\" style=\"width:100%; height:100%; object-fit:contain;\" alt=\"Perfect Score\" />";
    private const string IconStack = "<img src=\"/images/icons/stack.png\" style=\"width:100%; height:100%; object-fit:contain;\" alt=\"5 Lessons\" />";


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _studentId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        var email = user.Identity?.Name ?? string.Empty;
        if (email.Contains('@'))
        {
            DisplayFirstName = email[..email.IndexOf('@')];
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        NextLesson = await db.Lessons
            .Where(l => l.ReleaseDate <= DateOnly.FromDateTime(DateTime.UtcNow))
            .OrderByDescending(l => l.ReleaseDate)
            .FirstOrDefaultAsync();

        NextSession = await db.LiveSessions
            .Where(s => s.ScheduledAt >= DateTime.UtcNow)
            .OrderBy(s => s.ScheduledAt)
            .FirstOrDefaultAsync();

        if (string.IsNullOrEmpty(_studentId))
        {
            Achievements = BuildAchievements(attemptCount: 0, perfectScore: false, streak: 0, lessonsCompleted: 0, earlyBird: false);
            return;
        }

        var attempts = await db.QuizAttempts
            .Where(a => a.StudentId == _studentId)
            .ToListAsync();

        var attendances = await db.Attendances
            .Where(a => a.StudentId == _studentId)
            .ToListAsync();

        var quizIds = attempts.Select(a => a.QuizId).Distinct().ToList();
        var questionCounts = await db.QuizQuestions
            .Where(q => quizIds.Contains(q.QuizId))
            .GroupBy(q => q.QuizId)
            .Select(g => new { QuizId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.QuizId, x => x.Count);

        double ToPercent(QuizAttempt a) =>
            questionCounts.TryGetValue(a.QuizId, out var total) && total > 0
                ? a.Score * 100.0 / total : 0;

        LessonsCompletedCount = attempts.Select(a => a.QuizId).Distinct().Count();
        AverageQuizScore = attempts.Count > 0 ? attempts.Average(ToPercent) : null;
        SessionsAttendedCount = attendances.Count;

        var activityDates = attempts.Select(a => a.SubmittedAt.Date)
            .Concat(attendances.Select(a => a.CheckedInAt.Date))
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();

        (CurrentStreak, LongestStreak) = ComputeStreaks(activityDates);

        var earlyBird = attempts.Any(a => a.SubmittedAt.Hour < 8);
        var perfectScore = attempts.Any(a => questionCounts.TryGetValue(a.QuizId, out var t) && t > 0 && a.Score == t);

        Achievements = BuildAchievements(attempts.Count, perfectScore, CurrentStreak, LessonsCompletedCount, earlyBird);

        // SubmittedAt / CheckedInAt are DateTimeOffset; convert with .DateTime
        // when constructing ActivityItem (which expects DateTime):
        var quizActivity = attempts
            .OrderByDescending(a => a.SubmittedAt)
            .Take(3)
            .Select(a => new ActivityItem($"Scored {(int)Math.Round(ToPercent(a))}% on a quiz", a.SubmittedAt.DateTime));

        var attendanceActivity = attendances
            .OrderByDescending(a => a.CheckedInAt)
            .Take(3)
            .Select(a => new ActivityItem("Checked in to a live session", a.CheckedInAt.DateTime));

        RecentActivity = quizActivity.Concat(attendanceActivity)
            .OrderByDescending(a => a.When)
            .Take(5)
            .ToList();
    }

    private static (int current, int longest) ComputeStreaks(List<DateTime> datesDescending)
    {
        if (datesDescending.Count == 0) return (0, 0);

        var cursor = DateTime.UtcNow.Date;
        if (!datesDescending.Contains(cursor)) cursor = cursor.AddDays(-1);

        var current = 0;
        while (datesDescending.Contains(cursor))
        {
            current++;
            cursor = cursor.AddDays(-1);
        }

        var longest = 1;
        var run = 1;
        for (int i = 1; i < datesDescending.Count; i++)
        {
            if (datesDescending[i - 1].AddDays(-1) == datesDescending[i])
            {
                run++;
                longest = Math.Max(longest, run);
            }
            else
            {
                run = 1;
            }
        }

        return (current, longest);
    }

    private List<Achievement> BuildAchievements(int attemptCount, bool perfectScore, int streak, int lessonsCompleted, bool earlyBird) => new()
    {
        new("First Quiz", "Complete your first quiz", IconMedal, attemptCount >= 1),
        new("5-Day Streak", "Stay active 5 days in a row", IconFlame, streak >= 5),
        new("Perfect Score", "Score 100% on a quiz", IconTarget, perfectScore),
        new("5 Lessons", "Complete quizzes for 5 lessons", IconStack, lessonsCompleted >= 5),
        new("Early Bird", "Submit a quiz before 8 AM", IconSunrise, earlyBird),
    };
}