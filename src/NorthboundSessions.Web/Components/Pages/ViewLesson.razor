@page "/lessons/{LessonId:int}"
@rendermode InteractiveServer
@layout AppLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using NorthboundSessions.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SlideService SlideService
@inject IJSRuntime JS
@inject NavigationManager Nav
@using NorthboundSessions.Web.Data
@using NorthboundSessions.Web.Services


@if (lesson is null)
{
    <p>Loading...</p>
}
else
{
    <div style="display:grid; grid-template-columns: 1.6fr 1fr; gap:32px;">
        <div>
            <span style="font-size:12.5px; color:#16A34A; font-weight:600; text-transform:uppercase;">
                Slide @(currentSlideIndex + 1) of @slides.Count
            </span>
            <h2 style="font-family:'Source Serif 4',serif; color:#1F2A44;">
                @slides[currentSlideIndex].Title
            </h2>
            <p style="font-size:15px; line-height:1.7; color:#374151;">
                @slides[currentSlideIndex].BodyText
            </p>

            <img src="/api/lessons/@lesson.Id/image"
            alt="@lesson.Title"
            style="width:100%; max-width:600px; aspect-ratio:16/9; object-fit:cover; border-radius:8px; margin-bottom:20px;" />

            <div style="margin-top:24px; display:flex; gap:12px;">
                <button @onclick="GoBack" disabled="@(currentSlideIndex == 0)">Back</button>

                @if (currentSlideIndex < slides.Count - 1)
                {
                    <button @onclick="GoNext">Next</button>
                }
                else if (lesson.Quizzes.Any())
                {
                    <button @onclick="@(() => Nav.NavigateTo($"/quizzes/{lesson.Quizzes.First().Id}/take"))">
                        Take the quiz
                    </button>
                }
            </div>
        </div>

        <div>
            @if (!string.IsNullOrWhiteSpace(lesson.MarketSymbol))
            {
                <div id="tv-chart-container"></div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int LessonId { get; set; }

    private Lesson? lesson;
    private List<Slide> slides = new();
    private int currentSlideIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        lesson = await context.Lessons
            .Include(l => l.Quizzes)
            .FirstOrDefaultAsync(l => l.Id == LessonId);

        if (lesson is not null)
        {
            slides = SlideService.GenerateSlides(lesson);
        }
    }

    
    private bool chartInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartInitialized && lesson is not null && !string.IsNullOrWhiteSpace(lesson.MarketSymbol))
        {
            await JS.InvokeVoidAsync("initTradingViewWidget", "tv-chart-container", lesson.MarketSymbol);
            chartInitialized = true;
        }
    }

    private void GoBack()
    {
        if (currentSlideIndex > 0) currentSlideIndex--;
    }

    private void GoNext()
    {
        if (currentSlideIndex < slides.Count - 1) currentSlideIndex++;
    }
}